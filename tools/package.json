{
  "name": "leetcode-that-editor-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One-time build of the CodeMirror 6 bundle committed to assets/vendor/cm6.bundle.js. You never need to run this to USE the site.",
  "scripts": {
    "build": "esbuild editor-src.mjs --bundle --format=iife --global-name=CM6RAW --minify --outfile=../assets/vendor/cm6.bundle.js --legal-comments=none"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1"
  }
}
